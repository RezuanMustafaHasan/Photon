NODE_ENV=production
PORT=5050
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/photon?retryWrites=true&w=majority
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Photon Admin
ADMIN_ROLE=admin
ADMIN_CORS_ORIGINS=https://your-admin-frontend-static-site.onrender.com
TRUST_PROXY=1
CLOUDINARY_CLOUD_NAME=replace-if-using-image-uploads
CLOUDINARY_API_KEY=replace-if-using-image-uploads
CLOUDINARY_API_SECRET=replace-if-using-image-uploads
CLOUDINARY_FOLDER=photon/lesson-images
