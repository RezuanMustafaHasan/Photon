NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/photon?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
FASTAPI_BASE_URL=https://your-fastapi-service.onrender.com
FASTAPI_INTERNAL_API_KEY=replace-with-the-same-random-value-used-by-fastapi
CORS_ORIGINS=https://your-frontend-static-site.onrender.com
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_URL=rediss://default:password@host.upstash.io:6379
